<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="SortLab.MainWindow" Title="Sort Lab" Width="1040" Height="730" MinWidth="790" MinHeight="650"
 Background="#FAFAFC" FontFamily="fonts:Inter#Inter" Foreground="#202332">
 <Window.Styles>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,8"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#4843B9"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#545665"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#DDDDE6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,16"/></Style>
 </Window.Styles>
 <Grid ColumnDefinitions="230,*">
  <Border Background="#EFEEF5" Padding="20,26" BorderBrush="#DCDCE4" BorderThickness="0,0,1,0">
   <StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Border Background="#4843B9" CornerRadius="9" Padding="8"><PathIcon Foreground="White" Width="19" Height="19" Data="M1,12 H5 V20 H1 Z M8,7 H12 V20 H8 Z M15,1 H19 V20 H15 Z"/></Border>
     <TextBlock FontWeight="Bold" FontSize="23" VerticalAlignment="Center" Text="Sort Lab"/>
    </StackPanel>
    <TextBlock Classes="caption" Margin="0,26,0,0" Text="Алгоритм"/>
    <ListBox Name="Algorithms" SelectedIndex="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Алгоритм">
     <ListBoxItem Content="Сортировка выбором"/><ListBoxItem Content="Пирамидальная"/>
    </ListBox>
    <Separator Margin="0,12"/>
    <TextBlock Classes="caption" Text="Исходный массив"/>
    <TextBox Name="Input" Text="8 3 6 1 7 4 2 5" AcceptsReturn="False" TextWrapping="Wrap" AutomationProperties.Name="Числа через пробел"/>
    <TextBlock Classes="caption" TextWrapping="Wrap" Text="От 1 до 16 целых чисел через пробел или запятую."/>
    <Button Name="Randomize" Content="Случайный массив"/>
    <TextBlock Name="DelayLabel" Classes="caption" Margin="0,18,0,0"/>
    <Slider Name="Delay" Minimum="100" Maximum="2000" Value="600" TickFrequency="100" IsSnapToTickEnabled="True" AutomationProperties.Name="Задержка в миллисекундах"/>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,22" RowDefinitions="Auto,Auto,*,Auto,Auto,0.8*" RowSpacing="12">
   <TextBlock Classes="caption" Text="Лабораторная работа 4   /   Внутренняя сортировка"/>
   <StackPanel Grid.Row="1" Spacing="4"><TextBlock Name="Heading" FontSize="30" FontWeight="Bold"/><TextBlock Name="Intro" Classes="caption" TextWrapping="Wrap"/></StackPanel>
   <Border Classes="card" Grid.Row="2"><Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Массив" FontWeight="SemiBold" FontSize="17"/><TextBlock Grid.Column="1" Name="Stats" Classes="caption"/></Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Name="Bars" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Center"/></ScrollViewer>
   </Grid></Border>
   <TextBlock Grid.Row="3" Name="Explanation" TextWrapping="Wrap" MinHeight="44" VerticalAlignment="Center"/>
   <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
    <Button Name="Play" Classes="primary" Content="Запустить"/><Button Name="Next" Content="Один шаг"/><Button Name="Reset" Content="Сначала"/>
   </StackPanel>
   <Border Grid.Row="5" Classes="card"><Grid RowDefinitions="Auto,*" RowSpacing="8">
    <TextBlock FontWeight="SemiBold" FontSize="17" Text="Журнал операций"/>
    <ListBox Grid.Row="1" Name="Log" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Журнал операций">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
